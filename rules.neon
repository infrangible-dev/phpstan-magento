# Rules for the conventions of PhpStorm that PHPStan does not check itself, and @throws tags as PhpStorm expects them.
# Included by magento.neon; projects without Magento can include this file alone.
parameters:
    # every checked exception that a method lets through has to be declared, and not more than that; unchecked are the
    # same exceptions as in the PhpStorm settings of the Magento modules. The rules below add what PhpStorm checks beyond
    # that: @throws of the method itself, not only of a parent, and catches of exceptions that no call of the try block
    # declares
    exceptions:
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        uncheckedExceptionClasses:
            - Error
            - LogicException
            - RuntimeException
            # PHPUnit declares interfaces like PHPUnit\Framework\MockObject\Exception in @throws of createMock()
            - PHPUnit\Exception
rules:
    # a literal as last argument that is the default value of the parameter
    - Infrangible\PhpStan\DefaultArgumentRule
    # a foreach loop that only fills an empty array with one value per element
    - Infrangible\PhpStan\LoopToArrayMapRule
    # a method without native return type, unless it returns a resource
    - Infrangible\PhpStan\MissingReturnTypeRule
    # an instance created by reflection, returned by a function with a class as native return type
    - Infrangible\PhpStan\ReflectionInstanceReturnRule
    # an assignment to a variable whose value is overwritten before it is read
    - Infrangible\PhpStan\OverwrittenAssignmentRule
    # a constructor that does not call the constructor of its parent class
    - Infrangible\PhpStan\MissingParentConstructorCallRule
    # a member of the value of a property that only exists after an instanceof check of the property
    - Infrangible\PhpStan\NarrowedPropertyAccessRule
    # a catch of a checked exception that no call of the try block declares
    - Infrangible\PhpStan\NeverThrownCatchRule
    # an instanceof check against the only class of the module that implements the declared interface
    - Infrangible\PhpStan\OnlyImplementationInstanceofRule
    # checked exceptions declared only in the @throws tag of a parent method
    - Infrangible\PhpStan\OwnThrowsRule
    # an assertion of a method call that repeats an earlier one without any use of the object in between
    - Infrangible\PhpStan\RepeatedAssertionRule
    # a suppression of unused parameters on a method that overrides a parent method, is overridden by a subclass or uses
    # all parameters (collected by the collectors below)
    - Infrangible\PhpStan\RedundantUnusedParameterSuppressionRule
    # an inline @var tag of an assignment with the type that the assigned value already has
    - Infrangible\PhpStan\RedundantVarTagRule
    # a test double of PHPUnit returned as a template type of the method
    - Infrangible\PhpStan\TemplateTestDoubleReturnRule
    # an unpacked array literal as argument that itself unpacks an array, PhpStorm counts its elements as arguments
    - Infrangible\PhpStan\SpreadArrayLiteralArgumentRule
    # a test double of PHPUnit created inside a closure
    - Infrangible\PhpStan\TestDoubleInClosureRule
    # a parameter that the method does not use, unless the method overrides another one, is overridden by a subclass or
    # suppresses it (collected by the collectors below)
    - Infrangible\PhpStan\UnusedParameterRule
    # a variable that is assigned once and then only passed by value to one closure
    - Infrangible\PhpStan\VariableOnlyUsedInClosureRule
services:
    # the methods of parent classes that methods override, the unused parameters and the suppressions of unused
    # parameters, for UnusedParameterRule and RedundantUnusedParameterSuppressionRule
    -
        class: Infrangible\PhpStan\OverriddenMethodCollector
        tags:
            - phpstan.collector
    -
        class: Infrangible\PhpStan\UnusedParameterCollector
        tags:
            - phpstan.collector
    -
        class: Infrangible\PhpStan\RedundantUnusedParameterSuppressionCollector
        tags:
            - phpstan.collector
    # throws tags with ReflectionException on test methods that call nothing which declares it, like PhpStorm judges
    -
        class: Infrangible\PhpStan\ReflectionThrowsTagCollector
        tags:
            - phpstan.collector
    -
        class: Infrangible\PhpStan\ReflectionThrowingCallCollector
        tags:
            - phpstan.collector
    -
        class: Infrangible\PhpStan\UnthrownReflectionExceptionRule
        tags:
            - phpstan.rules.rule
    # a cast of a value that already has the type of the cast; it reads the bodies of called methods with the parser
    -
        class: Infrangible\PhpStan\RedundantCastRule
        arguments:
            parser: @currentPhpVersionRichParser
        tags:
            - phpstan.rules.rule
    # the checked exceptions that the PHP stubs of PhpStorm declare, which PHPStan does not know
    -
        class: Infrangible\PhpStan\PhpStormThrowTypeExtension
        tags:
            - phpstan.dynamicFunctionThrowTypeExtension
            - phpstan.dynamicMethodThrowTypeExtension
            - phpstan.dynamicStaticMethodThrowTypeExtension
