{
    "name": "infrangible/phpstan-magento",
    "description": "PHPStan rules and configuration for Magento 2 modules: the checks of PhpStorm that PHPStan does not do itself, and the classes that Magento generates",
    "type": "phpstan-extension",
    "version": "1.2.12",
    "license": "MIT",
    "keywords": [
        "Magento",
        "PHPStan",
        "PhpStorm",
        "static analysis"
    ],
    "homepage": "https://github.com/infrangible-dev/phpstan-magento",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "phpstan/phpstan": "~1.12.0 || ~2.3.0"
    },
    "autoload": {
        "psr-4": {
            "Infrangible\\PhpStan\\": "src/"
        }
    }
}
